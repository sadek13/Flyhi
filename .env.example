# Copy this file to .env and add your own private keys.
# Never commit .env.

DEMO_MODE=false

DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com

CLIMATIQ_API_KEY=
CLIMATIQ_BASE_URL=https://api.climatiq.io
# /estimate is the path already verified in the user's current FlyHi setup.
# services.py also falls back to /data/v1/estimate on a 404.
CLIMATIQ_ESTIMATE_PATH=/estimate

OSRM_BASE_URL=https://router.project-osrm.org
FRANKFURTER_BASE_URL=https://api.frankfurter.dev

# Prototype-only rail/car price assumptions used so Cheapest/Balanced can be demonstrated.
# These are NOT bookable fares and are labelled as estimates in chatbot output.
RAIL_USD_PER_KM=0.11
CAR_USD_PER_KM=0.18

# Ticketmaster Discovery API — cultural events/activities.
TICKETMASTER_API_KEY=
TICKETMASTER_BASE_URL=https://app.ticketmaster.com/discovery/v2
